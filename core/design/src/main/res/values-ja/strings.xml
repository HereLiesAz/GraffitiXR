    <string name="nav_load">読み込み</string>

    <string name="nav_load_info">プロジェクトライブラリを開いて、以前に保存したプロジェクトを読み込みます。</string>


    <string name="nav_export">エクスポート</string>

    <string name="nav_export_info">すべての表示レイヤーを統合した画像をフォトギャラリーにエクスポートします。</string>


    <string name="nav_help">ヘルプ</string>

