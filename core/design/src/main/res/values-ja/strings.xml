<resources>

    <string name="app_name">GraffitiXR</string>


    <string name="nav_modes">モード</string>

    <string name="nav_modes_info">ARプロジェクション、オーバーレイ、モックアップ、ライトボックスモードを切り替えます。</string>


    <string name="nav_ar_mode">AR</string>

    <string name="nav_ar_mode_info">拡張現実を使用してアートワークを実際の壁に投影します。まず壁をスキャンしてアンカーを配置し、次にデザインレイヤーを追加します。</string>


    <string name="nav_overlay">オーバーレイ</string>

    <string name="nav_overlay_info">ARアンカーを使用せずに、ライブカメラフィード上にデザインをレイヤーします。素早いフレーミングや配置の確認に最適です。</string>


    <string name="nav_mockup">モックアップ</string>

    <string name="nav_mockup_info">壁の写真に合成されたデザインをプレビューします。カメラやスキャンは不要です。</string>


    <string name="nav_trace">ライトボックス</string>

    <string name="nav_trace_info">デザインをライトテーブルのオーバーレイとして使用し、物理的な表面に参照線をトレースします。</string>










    <string name="nav_grid">ターゲット</string>

    <string name="nav_grid_info">ARアンカーターゲットを作成および管理します。壁に描かれた参照マークを撮影して、投影を所定の位置に固定します。</string>





    <string name="nav_create">作成</string>

    <string name="nav_create_info">壁の参照マークを撮影して新しいARアンカーを作成します。アプリはこのマークを追跡して投影の配置を維持します。</string>


    <string name="nav_refine">調整</string>

    <string name="nav_refine_info">既存のARアンカーターゲットの位置を微調整します。</string>


    <string name="nav_update">進捗</string>

    <string name="nav_update_info">壁画の完了した部分をマークして、ペイントの進捗を追跡します。</string>


    <string name="nav_design">デザイン</string>

    <string name="nav_design_info">デザインレイヤーを追加および管理します。各レイヤーはインポートされた画像またはフリーハンドの描画にすることができます。</string>


    <string name="nav_open">開く</string>

    <string name="nav_open_info">ギャラリーから画像を新しいレイヤーとして追加します。</string>


    <string name="nav_wall">壁</string>

    <string name="nav_wall_info">モックアップモードで使用される背景の壁の写真を置き換えます。</string>


    <string name="nav_isolate">切り抜き</string>

    <string name="nav_isolate_info">このレイヤーから背景を自動的に削除し、透明な背景に被写体のみを残します。</string>


    <string name="nav_invert">反転</string>


    <string name="nav_blend">ブレンド</string>

    <string name="nav_invert_info">現在のレイヤーのネガを作成します。黒は白になり、色は反対色に反転します — ステンシルやオーバーレイの分析に便利です。</string>


    <string name="nav_outline">輪郭</string>

    <string name="nav_outline_info">このレイヤーを透明な背景の黒い線画に変換します — ステンシルテンプレートの作成に最適です。</string>


    <string name="nav_adjust">調整</string>

    <string name="nav_adjust_info">このレイヤーの明るさ、コントラスト、彩度、カラーバランスを微調整します。</string>


    <string name="nav_balance">カラー</string>

    <string name="nav_balance_info">赤、緑、青のチャンネルスライダーを使用してレイヤーの色を調整します。</string>


    <string name="nav_blending">ブレンド</string>

    <string name="nav_blending_info">ブレンドモード（通常、乗算、スクリーン、オーバーレイなど）を切り替えて、このレイヤーが下のレイヤーとどのように合成されるかを制御します。</string>


    <string name="nav_settings">設定</string>

    <string name="nav_settings_info">利き手、ARスキャンモード、単位、その他のアプリの設定を構成します。</string>


    <string name="nav_project">プロジェクト</string>

    <string name="nav_project_info">プロジェクトの管理: 作成、保存、読み込み、エクスポート。</string>


    <string name="nav_new">新規</string>

    <string name="nav_new_info">新しい空のプロジェクトを開始します。保存されていない変更は失われます。</string>


    <string name="nav_save">保存</string>

