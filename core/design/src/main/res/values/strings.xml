<resources>
    <!-- The name of the application. -->
    <string name="app_name">GraffitiXR</string>

    <!-- Label for the navigation item that opens the mode selection menu. -->
    <string name="nav_modes">Modes</string>
    <!-- Description for the modes menu, explaining its purpose of switching app modes. -->
    <string name="nav_modes_info">Switch between AR Projection, Overlay, Mockup, and Trace modes.</string>

    <!-- Label for the Augmented Reality (AR) projection mode. -->
    <string name="nav_ar_mode">AR</string>
    <!-- Instructions for AR mode, explaining how to project artwork onto a wall. -->
    <string name="nav_ar_mode_info">Project your artwork onto a real wall using augmented reality. Scan the wall first to place the anchor, then add your design layers.</string>

    <!-- Label for the camera overlay mode, which doesn't use AR tracking. -->
    <string name="nav_overlay">Overlay</string>
    <!-- Description of Overlay mode, used for quick checks without spatial tracking. -->
    <string name="nav_overlay_info">Layer your design over the live camera feed without AR anchoring. Great for quick framing and placement checks.</string>

    <!-- Label for the Mockup mode, used for previewing on a static background. -->
    <string name="nav_mockup">Mockup</string>
    <!-- Description of Mockup mode, explaining that it uses a photo background instead of a live feed. -->
    <string name="nav_mockup_info">Preview your design composited onto a photo of a wall. No camera or scanning required.</string>

    <!-- Label for the Trace mode, which locks the screen for manual tracing. -->
    <string name="nav_trace">Trace</string>
    <!-- Description of Trace mode, explaining its use as a light-table for physical tracing. -->
    <string name="nav_trace_info">Use your design as a light-table overlay to trace reference lines onto a physical surface.</string>
    <!-- Alternative name for Trace mode, often referred to as Lightbox. -->

    <!-- Label for Canvas mode, which is optimized for smaller, desk-scale artwork. -->
    <!-- Label for Mural mode, which is optimized for large-scale wall artwork. -->
    <!-- Description for the toggle between Canvas and Mural scanning modes. -->
    <string name="nav_scan_mode_toggle_info">Switch between Canvas (optimized for smaller desk-scale art) and Mural (optimized for large-scale walls and Voxel-based spatial tracking).</string>

    <!-- Label for the Stencil generation tool. -->
    <!-- Description of the Stencil tool, explaining how it creates multi-layer printable templates. -->

    <!-- Label for the Target/Grid management menu in AR mode. -->
    <string name="nav_grid">Target</string>
    <!-- Description of Target management, used for anchor creation and management. -->
    <string name="nav_grid_info">Create and manage AR anchor targets. Photograph painted reference marks on the wall to lock the projection in place.</string>

    <!-- Label for the wall survey tool, used to improve AR tracking. -->
    <!-- Description of the Survey tool, explaining its role in tracking accuracy. -->

    <!-- Label for the action to create a new AR anchor. -->
    <string name="nav_create">Create</string>
    <!-- Instructions for creating a new AR anchor by photographing a mark on the wall. -->
    <string name="nav_create_info">Photograph a reference mark on the wall to create a new AR anchor. The app will track this mark to keep your projection aligned.</string>

    <string name="nav_coop">Co-op</string>
    <string name="nav_host_coop">Host</string>
    <string name="nav_host_coop_info">Host a co-op session to share your AR coordinate system with nearby peers.</string>
    <string name="nav_join_coop">Join</string>
    <string name="nav_join_coop_info">Join a nearby co-op session to align your AR view with the host.</string>
    <string name="nav_leave_coop">Leave</string>
    <string name="nav_leave_coop_info">Leave the current co-op session.</string>

    <string name="nav_wearable">Wearable</string>
    <string name="nav_wearable_info">Connect to smart glasses for a hands-free AR experience and perspective-aligned camera input.</string>

    <!-- Label for the action to refine an existing AR anchor. -->
    <string name="nav_refine">Refine</string>
    <!-- Description of the anchor refinement process. -->
    <string name="nav_refine_info">Fine-tune the position of an existing AR anchor target.</string>

    <!-- Label for the progress tracking tool. -->
    <string name="nav_update">Progress</string>
    <!-- Description of the progress tool, used for marking completed parts of a mural. -->
    <string name="nav_update_info">Mark completed areas of your mural to track painting progress.</string>

    <!-- Label for the Design workspace — the default screen you land on after opening or creating a
         project. There is no separate "Design" menu/button to tap; this just names that screen. -->
    <string name="nav_design">Design</string>
    <!-- Description of the Design workspace, where layers are added and managed. -->
    <string name="nav_design_info">Your workspace. Layers you add with \'Open\' — and edit with the tools below — carry over into every mode.</string>

    <!-- Action label to open or import an image. -->
    <string name="nav_open">Open</string>
    <!-- Description of the Open action, used to add an image layer from the gallery. -->
    <string name="nav_open_info">Add an image from your gallery as a new layer.</string>

    <!-- Label for the background wall image in Mockup mode. -->
    <string name="nav_wall">Wall</string>
    <!-- Description for the action to change the background wall image. -->
    <string name="nav_wall_info">Replace the background wall photo used in Mockup mode.</string>
    <!-- Label for the action to remove the background wall photo. -->
    <string name="nav_wall_clear">Clear</string>
    <!-- Description for the action to remove the background wall photo. -->
    <string name="nav_wall_clear_info">Remove the background wall photo used in Mockup mode.</string>

    <!-- Label for the subject-isolation effect. -->
    <string name="nav_isolate">Isolate</string>
    <!-- Label for the Magic tool: auto-fits the layer to the AR anchor, or auto-tones it. -->
    <string name="nav_magic">Magic</string>
    <!-- Label for the Edges tool: generates a Canny edge-detect outline of the layer. -->
    <string name="nav_edges">Edges</string>
    <!-- Description of the Isolate effect. -->
    <string name="nav_isolate_info">Keep only the subject of the design, making everything around it transparent. Tap again to bring the background back.</string>

    <!-- Label for the color inversion tool. -->
    <string name="nav_invert">Invert</string>
    <!-- Description of the Invert tool, explaining its use for stencil and overlay analysis. -->
    <string name="nav_invert_info">Create a negative of the current layer. Blacks become whites, and colors are flipped to their opposites — useful for stencil and overlay analysis.</string>

    <!-- Label for the outline filter. -->
    <string name="nav_outline">Outline</string>
    <!-- Description of the Outline filter, used for creating stencil templates. -->
    <string name="nav_outline_info">Render the design as a pencil sketch — dark lines, transparent elsewhere — which is the form you actually trace from. Tap again to return to the full image.</string>

    <!-- Label for image adjustment tools (brightness, contrast, etc.). -->
    <string name="nav_adjust">Adjust</string>
    <!-- Description of the image adjustment tools. -->
    <string name="nav_adjust_info">Fine-tune brightness, contrast, saturation, and color balance for this layer.</string>

    <!-- Label for color balance and tinting tools. -->
    <string name="nav_balance">Color</string>
    <!-- Description of the color balance tool, mentioning RGB sliders. -->
    <string name="nav_balance_info">Tint the layer colors using red, green, and blue channel sliders.</string>

    <!-- Label for layer blending mode selection. -->
    <string name="nav_blending">Blend</string>
    <!-- Description of blending modes, used to control how layers composite. -->
    <string name="nav_blending_info">Cycle through blend modes (Normal, Multiply, Screen, Overlay…) to control how this layer composites with layers below.</string>

    <!-- Label for the application settings menu. -->
    <string name="nav_settings">Settings</string>
    <!-- Description of the settings menu, listing configurable preferences. -->
    <string name="nav_settings_info">Configure handedness, AR scan mode, units, and other app preferences.</string>

    <!-- Label for the project management menu. -->
    <string name="nav_project">Project</string>
    <!-- Description of the project menu, covering file operations. -->
    <string name="nav_project_info">Manage your project: create, save, load, and export.</string>

    <!-- Action label to start a new project. -->
    <string name="nav_new">New</string>
    <!-- Description of the New Project action, including a warning about unsaved changes. -->
    <string name="nav_new_info">Start fresh empty project. Any unsaved changes will be lost.</string>

    <!-- Action label to save the current project. -->
    <string name="nav_save">Save</string>
    <!-- Description of the Save action. -->
    <string name="nav_save_info">Save the current project to your device.</string>

    <!-- Action label to load a project from the library. -->
    <string name="nav_load">Load</string>
    <!-- Description of the Load action, referencing the project library. -->
    <string name="nav_load_info">Open the project library to load a previously saved project.</string>

    <!-- Action label to export the final image. -->
    <string name="nav_export">Export</string>
    <!-- Description of the Export action, explaining it merges layers into one image. -->
    <string name="nav_export_info">Export a flat merged image of all visible layers to your photo gallery.</string>

    <!-- Label for the interactive help system. -->
    <string name="nav_help">Help</string>
    <!-- Description of how to use the interactive help system. -->
    <string name="nav_help_info">Tap any button while Help is active to see what it does.</string>

    <!-- Label for the flashlight toggle. -->
    <string name="nav_light">Light</string>
    <!-- Description of the flashlight toggle for working in low light. -->
    <string name="nav_light_info">Toggle the device flashlight to illuminate your wall while working in low light.</string>

    <!-- Label for the touch input lock feature. -->
    <!-- Description of the touch lock, explaining how to unlock it. -->
    <string name="nav_lock_info">Lock the touchscreen to prevent accidental changes while you spray. Triple-tap anywhere to unlock.</string>


